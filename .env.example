# Copie este arquivo para .env e preencha os valores:  cp .env.example .env

# Chave secreta do Django. Gere uma com:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
# Mantenha as aspas simples: a chave pode conter '$', que o Docker Compose interpretaria como variavel.
SECRET_KEY='change-me'

# Use True apenas em desenvolvimento
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# PostgreSQL
DB_NAME=bibliotech
DB_USER=bibliotech
DB_PASSWORD=change-me
DB_HOST=localhost
DB_PORT=5432
